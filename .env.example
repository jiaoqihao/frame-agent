# demo validates the extension workflow without paid calls; output is labelled demo.
# live enables LLM routing + SVG skill and a separate third-party image API.
PROVIDER=demo
PORT=8787
DATA_DIR=.data

# Language model: Responses or OpenAI-compatible Chat Completions.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_STYLE=responses

# Independent image service (OpenAI-compatible Images API).
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_MODEL=gpt-image-1
IMAGE_API_SUPPORTS_EDIT=true
IMAGE_API_RESPONSE_FORMAT=auto
# Comma-separated HTTPS hosts for URL-only image responses. No wildcards.
IMAGE_DOWNLOAD_HOSTS=

# Existing OPENAI_API_KEY / OPENAI_BASE_URL / PLANNER_MODEL / IMAGE_MODEL remain supported.
