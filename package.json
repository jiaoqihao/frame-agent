{
  "name": "frame-agent",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:extension": "vite build --watch",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "build": "node scripts/icons.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:extension": "node tests/extension-smoke.mjs && node tests/quick-menu-smoke.mjs",
    "test:settings": "node tests/settings-ui.mjs",
    "format": "prettier --write src server tests public *.json *.ts *.html README.md",
    "test:workspace": "node tests/workspace-ui.mjs",
    "start": "node scripts/launch.mjs"
  },
  "dependencies": {
    "@antv/infographic": "0.2.20",
    "@resvg/resvg-js": "^2.6.2",
    "@xmldom/xmldom": "^0.9.12",
    "echarts": "6.1.0",
    "lucide-react": "^0.468.0",
    "playwright": "1.64.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
